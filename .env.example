# ==========================================
# INDEX MATRIX — Environment Configuration
# ==========================================

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SECRET=index-matrix-super-secret-key-min-32-chars-long-1234567890

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Or for SQLite testing: file:./dev.db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/index_matrix?schema=public"

# Redis & Queues (Optional in mock/in-memory mode, required in production worker mode)
REDIS_URL="redis://localhost:6379"
REDIS_QUEUE_PREFIX="index_matrix"

# Initial Owner / Admin Account (Created on first run / seed)
OWNER_EMAIL="owner@indexmatrix.io"
OWNER_INITIAL_PASSWORD="ChangeMeImmediately123!"

# Security & Encryption (AES-256-GCM 32-byte hex key for encrypting Google OAuth refresh tokens)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Google OAuth 2.0 & Search Console API
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/google/callback"

# Payments Configuration (Sandbox / Test Mode by default)
PAYMENT_PROVIDER="stripe" # "stripe" | "razorpay" | "mock"
# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Razorpay
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Logging & Monitoring
LOG_LEVEL="info" # "debug" | "info" | "warn" | "error"
